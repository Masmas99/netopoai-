# Environment Variables Example for NetTopo AI

# Backend Configuration (FastAPI)
PORT=8000
HOST=127.0.0.1
DEBUG=True
CORS_ORIGINS=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netopoai

# AI Service Provider (e.g. OpenAI, Anthropic, or Local LLM)
AI_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=generate-a-secure-random-secret
NEXTAUTH_URL=http://localhost:3000

